{
    "name": "gemorroj/stop-spam",
    "description": "Wrapper for API www.stopforumspam.com (api.stopforumspam.org)",
    "keywords": ["stopforumspam", "antispam", "blacklist", "spam-filtering", "spam-protection", "spam-detection"],
    "type": "library",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Gemorroj"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/http-client": "^7.4||^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5||^12.5||^13",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "StopSpam\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StopSpam\\Tests\\": "tests/"
        }
    }
}
